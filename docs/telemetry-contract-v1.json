{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GAC telemetry contract",
  "contract_version": 1,
  "schema_version": 1,
  "consent_version": 1,
  "notice_version": 1,
  "description": "Pseudonymous installation telemetry for GAC. Off by default; explicitly opt-in. The identifier links events from one installation over time and is not a count of unique people.",
  "attribution": "Developed by alhisan >|",
  "endpoints": {
    "ingest": "https://api.getgac.dev/v1/events/batch",
    "contract": "https://api.getgac.dev/v1/telemetry-contract",
    "docs": "https://getgac.dev/telemetry",
    "privacy": "https://getgac.dev/privacy"
  },
  "identifier": {
    "kind": "pseudonymous installation id",
    "derivation": "SHA-256(\"gac-telemetry-v1:\" + installationId)",
    "format": "64 lowercase hexadecimal characters",
    "notes": "installationId is a locally generated random UUID. It is not derived from any user, account, network, hardware, hostname, or filesystem attribute. The raw UUID is never transmitted. It changes when telemetry is disabled and re-enabled."
  },
  "ip_handling": "The service necessarily receives the source IP while processing the HTTPS request, but is designed not to persist it in its telemetry database or application logs.",
  "transport": {
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "Accept": "application/json",
      "User-Agent": "gac/<version>",
      "X-GAC-Telemetry-Schema": "1"
    },
    "limits": {
      "max_events_per_request": 50,
      "max_body_bytes": 65536,
      "compression": "none",
      "max_concurrent_batches": 1
    },
    "backoff_schedule_ms": [
      60000,
      300000,
      1800000,
      7200000,
      28800000,
      86400000
    ]
  },
  "enums": {
    "outcomes": [
      "success",
      "failure",
      "cancelled",
      "no_op"
    ],
    "error_categories": [
      "validation",
      "configuration",
      "authentication",
      "authorization",
      "network",
      "timeout",
      "rate_limited",
      "provider_4xx",
      "provider_5xx",
      "parse",
      "filesystem",
      "git",
      "shell",
      "blocked",
      "empty_response",
      "unknown"
    ],
    "platforms": [
      "linux",
      "darwin",
      "win32",
      "freebsd",
      "other"
    ],
    "arches": [
      "x64",
      "arm64",
      "arm",
      "ia32",
      "other"
    ],
    "providers": [
      "openai_compatible",
      "ollama",
      "codex",
      "unknown"
    ],
    "size_buckets": [
      "none",
      "1_100",
      "101_500",
      "501_2000",
      "2001_10000",
      "10001_50000",
      "50001_plus"
    ],
    "count_buckets": [
      "0",
      "1",
      "2_5",
      "6_10",
      "11_25",
      "26_plus"
    ],
    "context_window_buckets": [
      "unknown",
      "up_to_8k",
      "8k_to_32k",
      "32k_to_128k",
      "128k_plus"
    ],
    "attempt_count_buckets": [
      "1",
      "2",
      "3_5",
      "6_plus"
    ],
    "http_status_classes": [
      "none",
      "2xx",
      "4xx",
      "429",
      "5xx"
    ],
    "exit_code_classes": [
      "zero",
      "one",
      "two",
      "three_to_10",
      "11_to_127",
      "128_plus",
      "unknown"
    ],
    "input_modes": [
      "none",
      "arguments",
      "stdin",
      "files",
      "stdin_and_files"
    ]
  },
  "envelope_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "batch_id",
      "schema_version",
      "sent_at",
      "events"
    ],
    "properties": {
      "batch_id": {
        "type": "string",
        "format": "uuid"
      },
      "schema_version": {
        "const": 1
      },
      "sent_at": {
        "type": "string",
        "format": "date-time"
      },
      "events": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "items": {
          "oneOf": [
            {
              "$ref": "#/events/telemetry_enabled/schema"
            },
            {
              "$ref": "#/events/command_completed/schema"
            },
            {
              "$ref": "#/events/model_request_completed/schema"
            },
            {
              "$ref": "#/events/chat_action_completed/schema"
            },
            {
              "$ref": "#/events/runbook_plan_completed/schema"
            },
            {
              "$ref": "#/events/runbook_step_completed/schema"
            },
            {
              "$ref": "#/events/runbook_completed/schema"
            },
            {
              "$ref": "#/events/commit_action_completed/schema"
            },
            {
              "$ref": "#/events/fix_action_completed/schema"
            }
          ]
        }
      }
    }
  },
  "success_response_schema": {
    "type": "object",
    "additionalProperties": true,
    "required": [
      "request_id",
      "accepted_event_ids",
      "server_time"
    ],
    "properties": {
      "request_id": {
        "type": "string"
      },
      "accepted_event_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "duplicate_event_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "rejected": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "event_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "server_time": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
